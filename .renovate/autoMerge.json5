{
	$schema: "https://docs.renovatebot.com/renovate-schema.json",
	packageRules: [
		{
			description: "Auto-merge trusted OCI digests",
			matchDatasources: ["docker"],
			automerge: true,
			automergeType: "pr",
			matchUpdateTypes: ["digest"],
			matchPackageNames: ["/tholinka/", "/home-operations/", "/linuxserver/"],
			ignoreTests: false,
		},
		{
			description: "Auto-merge high-cadence OCI packages weekly",
			matchDatasources: ["docker"],
			automerge: true,
			automergeType: "pr",
			matchUpdateTypes: ["minor", "patch"],
			matchPackageNames: ["ghcr.io/renovatebot/renovate"],
			ignoreTests: false,
			schedule: ["before 6am on Sunday"],
		},
		{
			description: "Auto-merge trusted GitHub Actions",
			matchManagers: ["github-actions"],
			matchPackageNames: ["/^actions\//"],
			automerge: true,
			automergeType: "branch",
			matchUpdateTypes: ["minor", "patch", "digest"],
			minimumReleaseAge: "1 minute",
			ignoreTests: true,
		},
		{
			// Merge Flate updates for mise and github action together,
			// and also don't wait the standard time before merging actions
			description: "Flate Group",
			groupName: "Flate",
			matchManagers: ["github-actions", "mise"],
			matchPackageNames: ["/flate/"],
			group: {
				commitMessageTopic: "{{{groupName}}} group",
			},
			minimumGroupSize: 4,
			minimumReleaseAge: "1 hour",
			automerge: true,
			automergeType: "pr",
			ignoreTests: true,
		},
	],
}
